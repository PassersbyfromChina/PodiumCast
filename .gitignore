# ---------------------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------------------
node_modules/
.pnpm-store/

dist/
out/
release/
.podiumcast-out/
*.tsbuildinfo

# ---------------------------------------------------------------------------------------
# apps/desktop/build holds the generated application icons (icon.png / .ico / .icns).
# Those ARE deliverables — they are what makes the installers look like PodiumCast rather
# than like Electron — so the generic `build/` rule must not swallow them.
# ---------------------------------------------------------------------------------------
/apps/desktop/build/*
!/apps/desktop/build/icon.png
!/apps/desktop/build/icon.ico
!/apps/desktop/build/icon.icns

# ---------------------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------------------
apps/android/android/.gradle/
apps/android/android/build/
apps/android/android/app/build/
apps/android/android/local.properties
apps/android/android/.idea/
apps/android/android/app/.cxx/

# Generated by `cap sync` / the build script, not sources.
apps/android/android/app/src/main/assets/public/
apps/android/android/app/src/main/assets/capacitor.config.json
apps/android/android/app/src/main/assets/capacitor.plugins.json
apps/android/android/app/src/main/assets/native-bridge.js
apps/android/android/app/src/cast/assets/public/
apps/android/android/app/src/stage/assets/public/

# Self-signed signing key generated on first build. A real release key must never be
# committed; this one only exists so an unsigned-by-default APK is still installable.
apps/android/android/app/podiumcast.keystore

# ---------------------------------------------------------------------------------------
# Installers and packages: published as GitHub Release assets, not committed to git.
# (说明\交付物.xlsx lists the 12 things the release must contain.)
# ---------------------------------------------------------------------------------------
交付物/*.exe
交付物/*.dmg
交付物/*.apk
交付物/*.AppImage

# ---------------------------------------------------------------------------------------
# Local noise
# ---------------------------------------------------------------------------------------
*.log
_tmp/
_dump*
scripts/toolchain/.cache/
Thumbs.db
desktop.ini
.DS_Store
