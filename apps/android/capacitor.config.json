{
  "appId": "io.github.passersbyfromchina.podiumcast",
  "appName": "PodiumCast",
  "webDir": "www",
  "bundledWebRuntime": false,
  "loggingBehavior": "debug",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#000000"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#000000"
    }
  }
}
